{
  "provider": {
    "description": "文生图服务商",
    "type": "string",
    "default": "dashscope",
    "options": [
      "dashscope",
      "seedream"
    ]
  },
  "dashscope_base_url": {
    "description": "百炼文生图 API 地址",
    "type": "string",
    "hint": "默认使用 multimodal-generation 同步端点",
    "default": "https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation"
  },
  "dashscope_api_key": {
    "description": "阿里云百炼 DashScope API Key",
    "type": "string",
    "default": "",
    "obvious_hint": true
  },
  "dashscope_model": {
    "description": "百炼模型名称",
    "type": "string",
    "default": "qwen-image-2.0-pro",
    "options": [
      "qwen-image-2.0-pro",
      "qwen-image-2.0",
      "qwen-image-plus",
      "wan2.6-t2i",
      "wanx-v1"
    ]
  },
  "dashscope_size": {
    "description": "百炼默认输出尺寸（16:9）",
    "type": "string",
    "hint": "用户可在 prompt 中用 \"16:9\" / \"1:1\" 等比例关键词动态覆盖",
    "default": "2048*1152"
  },
  "dashscope_n": {
    "description": "百炼每次生成张数",
    "type": "int",
    "default": 1,
    "slider": {
      "min": 1,
      "max": 4,
      "step": 1
    }
  },
  "dashscope_seed": {
    "description": "百炼随机种子（0=每次随机）",
    "type": "int",
    "hint": "设 0 则每次调用自动生成随机种子，避免图片雷同；设固定值则每次输出一致",
    "default": 0,
    "slider": {
      "min": 0,
      "max": 2147483647,
      "step": 1
    }
  },
  "seedream_base_url": {
    "description": "豆包 Seedream API 地址",
    "type": "string",
    "default": "https://ark.cn-beijing.volces.com/api/v3/images/generations"
  },
  "seedream_api_key": {
    "description": "豆包 Seedream API Key（火山引擎 Ark）",
    "type": "string",
    "default": "",
    "obvious_hint": true
  },
  "seedream_model": {
    "description": "Seedream 模型名称",
    "type": "string",
    "default": "doubao-seedream-4.0"
  },
  "seedream_size": {
    "description": "Seedream 默认输出尺寸（16:9）",
    "type": "string",
    "hint": "用户可在 prompt 中用 \"16:9\" / \"1:1\" 等比例关键词动态覆盖",
    "default": "2048x1152"
  },
  "seedream_n": {
    "description": "Seedream 每次生成张数",
    "type": "int",
    "default": 1,
    "slider": {
      "min": 1,
      "max": 4,
      "step": 1
    }
  },
  "seedream_seed": {
    "description": "Seedream 随机种子（0=每次随机）",
    "type": "int",
    "hint": "设 0 则每次调用自动生成随机种子，避免图片雷同",
    "default": 0,
    "slider": {
      "min": 0,
      "max": 2147483647,
      "step": 1
    }
  },
  "timeout": {
    "description": "请求超时(秒)",
    "type": "int",
    "default": 120,
    "slider": {
      "min": 15,
      "max": 600,
      "step": 5
    }
  }
}